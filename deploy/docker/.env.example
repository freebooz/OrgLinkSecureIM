# 复制为 .env 后填写互不相同的随机秘密；不要提交 .env。
ORGLINK_POSTGRES_ADMIN_PASSWORD=
ORGLINK_DATABASE_PASSWORD=
ORGLINK_MESSAGE_STORAGE_KEY=
# MinIO 桶保持私有；访问密钥至少 3 字符，秘密至少 16 字符且不得与数据库口令相同。
ORGLINK_MINIO_ACCESS_KEY=orglinkminio
ORGLINK_MINIO_SECRET_KEY=
ORGLINK_MINIO_BUCKET=orglink-files
ORGLINK_MINIO_CONSOLE_PORT=9001
# LiveKit API Secret 至少 16 字符；PUBLIC_HOST/NODE_IP 填写客户端可直达的服务器局域网 IPv4。
ORGLINK_LIVEKIT_API_KEY=orglink-livekit
ORGLINK_LIVEKIT_API_SECRET=
ORGLINK_PUBLIC_HOST=
ORGLINK_LIVEKIT_NODE_IP=
ORGLINK_LIVEKIT_SIGNAL_PORT=7880
ORGLINK_LIVEKIT_RTC_TCP_PORT=7881
ORGLINK_LIVEKIT_RTC_UDP_PORT=7882
ORGLINK_CONFERENCE_WEB_PORT=7888
ORGLINK_BOOTSTRAP_LOGIN=admin
ORGLINK_BOOTSTRAP_PASSWORD=
ORGLINK_BOOTSTRAP_DISPLAY_NAME=系统管理员
ORGLINK_GATEWAY_PUBLISHED_PORT=7443
# 可替换为单位镜像仓库的 PostgreSQL 16 兼容镜像；不填时使用 postgres:16-bookworm。
ORGLINK_POSTGRES_IMAGE=
ORGLINK_MINIO_IMAGE=quay.io/minio/minio:RELEASE.2025-09-07T16-13-09Z
ORGLINK_MINIO_MC_IMAGE=quay.io/minio/mc:RELEASE.2025-08-13T08-35-41Z
ORGLINK_LIVEKIT_IMAGE=livekit/livekit-server:v1.13.1
